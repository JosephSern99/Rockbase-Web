# Base URL of the Spring Boot API (e.g. https://api.rockbase.example).
# Unset in local dev until the backend exists — POST /api/leads returns a
# clear "not configured" error rather than faking success.
API_BASE_URL=

# Public site URL, used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
